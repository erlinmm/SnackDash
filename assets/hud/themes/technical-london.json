{
  "canvas": [
    1280,
    720
  ],
  "defaultColor": "#15243a",
  "widgets": [
    {
      "id": "qaHudGroup",
      "type": "container",
      "rect": [
        8,
        95,
        236,
        232
      ],
      "background": "#18334a",
      "radius": 15,
      "children": [
        {
          "id": "qaLogo",
          "type": "image",
          "rect": [
            18,
            10,
            200,
            50
          ],
          "images": {
            "normal": "qa/hud-logo.svg",
            "fever": "qa/hud-logo.svg",
            "inferno": "qa/hud-logo.svg"
          }
        },
        {
          "id": "hudScore",
          "type": "text",
          "rect": [
            5,
            64,
            226,
            50
          ],
          "binding": "score.current",
          "fontSize": 37,
          "format": "compact",
          "color": "#ffdd7d"
        },
        {
          "id": "hudLevel",
          "type": "text",
          "rect": [
            5,
            114,
            100,
            40
          ],
          "binding": "race.index",
          "fontSize": 24,
          "color": "#fff"
        },
        {
          "id": "hudTime",
          "type": "text",
          "rect": [
            100,
            114,
            130,
            40
          ],
          "binding": "time.remaining",
          "fontSize": 24,
          "format": "clock",
          "color": "#fff"
        },
        {
          "id": "comboPanel",
          "type": "text",
          "rect": [
            5,
            154,
            226,
            40
          ],
          "binding": "combo.label",
          "fontSize": 22,
          "color": "#fff"
        },
        {
          "id": "qaProgress",
          "type": "progress",
          "rect": [
            10,
            203,
            216,
            12
          ],
          "binding": "combo.progress",
          "background": "#547182",
          "color": "#e9c065",
          "radius": 6
        }
      ]
    },
    {
      "id": "levelsBtn",
      "type": "button",
      "rect": [
        12,
        12,
        122,
        70
      ],
      "command": "menu",
      "text": "‹",
      "fontSize": 18,
      "images": {
        "normal": "hud/normal/progress_panel_empty",
        "fever": "hud/fever/progress_panel_empty",
        "inferno": "hud/inferno/progress_panel_empty"
      },
      "textKey": "hud.levels",
      "labelKey": "hud.backToLevels"
    },
    {
      "id": "restartBtn",
      "type": "button",
      "rect": [
        928,
        12,
        76,
        70
      ],
      "command": "restart",
      "text": "↻",
      "fontSize": 25,
      "images": {
        "normal": "hud/normal/pause_button_empty",
        "fever": "hud/fever/pause_button_empty",
        "inferno": "hud/inferno/pause_button_empty"
      },
      "labelKey": "game.restartLevel"
    },
    {
      "id": "pauseBtn",
      "type": "button",
      "rect": [
        1008,
        12,
        76,
        70
      ],
      "command": "pause",
      "text": "Ⅱ",
      "fontSize": 25,
      "images": {
        "normal": "hud/normal/pause_button_empty",
        "fever": "hud/fever/pause_button_empty",
        "inferno": "hud/inferno/pause_button_empty"
      },
      "binding": "controls.pauseGlyph",
      "labelBinding": "controls.pauseLabel"
    },
    {
      "id": "tokyoSoundBtn",
      "type": "button",
      "rect": [
        1088,
        12,
        76,
        70
      ],
      "command": "sound",
      "text": "♪",
      "fontSize": 25,
      "images": {
        "normal": "hud/normal/pause_button_empty",
        "fever": "hud/fever/pause_button_empty",
        "inferno": "hud/inferno/pause_button_empty"
      },
      "binding": "audio.glyph",
      "labelBinding": "audio.label"
    },
    {
      "id": "gameFullscreenBtn",
      "type": "button",
      "rect": [
        1168,
        12,
        100,
        70
      ],
      "command": "fullscreen",
      "text": "⛶",
      "fontSize": 25,
      "images": {
        "normal": "hud/normal/fullscreen_button_empty",
        "fever": "hud/fever/fullscreen_button_empty",
        "inferno": "hud/inferno/fullscreen_button_empty"
      },
      "label": "Fullscreen"
    },
    {
      "id": "message",
      "type": "text",
      "rect": [
        24,
        92,
        300,
        58
      ],
      "binding": "message.text",
      "fontSize": 19,
      "color": "#fff",
      "background": "#29374ee8",
      "visibleWhen": {
        "binding": "message.active",
        "equals": true
      }
    },
    {
      "id": "countdown",
      "type": "container",
      "rect": [
        566,
        309,
        148,
        102
      ],
      "background": "#fff8dc",
      "radius": 22,
      "visibleWhen": {
        "binding": "race.countdownVisible",
        "equals": true
      },
      "children": [
        {
          "id": "countdownText",
          "type": "text",
          "rect": [
            0,
            0,
            148,
            102
          ],
          "binding": "race.countdown",
          "fontSize": 58,
          "color": "#bd416d"
        }
      ]
    },
    {
      "id": "pauseOverlay",
      "type": "container",
      "rect": [
        490,
        295,
        300,
        130
      ],
      "background": "#fff8e9",
      "radius": 22,
      "visibleWhen": {
        "binding": "race.phase",
        "equals": "paused"
      },
      "children": [
        {
          "id": "pauseTitle",
          "type": "text",
          "rect": [
            0,
            5,
            300,
            50
          ],
          "textKey": "tokyo.paused",
          "fontSize": 31
        },
        {
          "id": "resumeBtn",
          "type": "button",
          "rect": [
            10,
            65,
            280,
            55
          ],
          "command": "pause",
          "textKey": "game.resumeAria",
          "fontSize": 23
        }
      ]
    },
    {
      "id": "celebration",
      "type": "text",
      "rect": [
        465,
        103,
        350,
        52
      ],
      "textKey": "celebration.staffSuccess",
      "fontSize": 27,
      "background": "#fff7d8",
      "visibleWhen": {
        "binding": "race.celebrating",
        "equals": true
      }
    },
    {
      "id": "qaLabel",
      "type": "text",
      "rect": [
        1030,
        94,
        229,
        35
      ],
      "textKey": "tokyo.qaActive",
      "fontSize": 17,
      "color": "#fff5ef",
      "background": "#32284de8",
      "visibleWhen": {
        "binding": "race.fixture",
        "equals": true
      }
    },
    {
      "id": "resultOverlay",
      "type": "container",
      "rect": [
        0,
        0,
        1280,
        720
      ],
      "background": "#14243acc",
      "z": 200,
      "visibleWhen": {
        "binding": "result.visible",
        "equals": true
      },
      "modal": true,
      "children": [
        {
          "id": "resultCard",
          "type": "container",
          "rect": [
            370,
            112,
            540,
            496
          ],
          "background": "#fffaf1",
          "radius": 20,
          "children": [
            {
              "id": "resultHeading",
              "type": "text",
              "rect": [
                20,
                22,
                500,
                68
              ],
              "binding": "result.heading",
              "fontSize": 36
            },
            {
              "id": "resultScore",
              "type": "text",
              "rect": [
                20,
                98,
                500,
                84
              ],
              "binding": "score.current",
              "fontSize": 54,
              "format": "compact"
            },
            {
              "id": "resultExact",
              "type": "text",
              "rect": [
                20,
                185,
                500,
                36
              ],
              "binding": "score.exact",
              "fontSize": 18
            },
            {
              "id": "resultText",
              "type": "text",
              "rect": [
                20,
                226,
                500,
                82
              ],
              "binding": "result.text",
              "fontSize": 22
            },
            {
              "id": "resultStats",
              "type": "text",
              "rect": [
                20,
                311,
                500,
                46
              ],
              "binding": "result.stats",
              "fontSize": 20
            },
            {
              "id": "resultPrimary",
              "type": "button",
              "rect": [
                25,
                367,
                490,
                60
              ],
              "command": "result.next",
              "binding": "result.primary",
              "fontSize": 27,
              "background": "#f0be59",
              "radius": 10
            },
            {
              "id": "retryBtn",
              "type": "button",
              "rect": [
                25,
                437,
                237,
                48
              ],
              "command": "restart",
              "textKey": "game.retry",
              "fontSize": 22,
              "background": "#dce4ec",
              "radius": 8
            },
            {
              "id": "backBtn",
              "type": "button",
              "rect": [
                278,
                437,
                237,
                48
              ],
              "command": "menu",
              "textKey": "game.levels",
              "fontSize": 22,
              "background": "#dce4ec",
              "radius": 8
            }
          ]
        }
      ]
    }
  ],
  "animations": [
    {
      "event": "score",
      "target": "hudScore",
      "durationMs": 320,
      "keyframes": [
        {
          "at": 0,
          "scale": 1
        },
        {
          "at": 0.25,
          "scale": 1.08
        },
        {
          "at": 1,
          "scale": 1
        }
      ],
      "scaleBy": [
        {
          "minCombo": 5,
          "multiplier": 1.5
        },
        {
          "minCombo": 10,
          "multiplier": 2
        }
      ]
    },
    {
      "event": "mode.change",
      "target": "comboPanel",
      "durationMs": 450,
      "keyframes": [
        {
          "at": 0,
          "opacity": 0.5,
          "scale": 0.92
        },
        {
          "at": 0.35,
          "opacity": 1,
          "scale": 1.12
        },
        {
          "at": 1,
          "opacity": 1,
          "scale": 1
        }
      ]
    }
  ]
}